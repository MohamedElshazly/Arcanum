// fire_impact — explosive hit, low body + crackle. ~0.55s.
// setcps(1.8) → 1 cycle ≈ 0.55s. Record ONE cycle.

setcps(1.8)

stack(
  // Big low kick — main body of the explosion
  s("bd").bank("RolandTR909").gain(1.0),

  // Sub-rumble — short sawtooth thud
  note("c1").s("sawtooth").gain(0.7).release(0.4).lpf(500),

  // Mid-range body — gives the hit some mass
  note("c2").s("square").gain(0.5).release(0.3).lpf(900).resonance(4),

  // Crackle tail — debris falling
  s("hh*8").bank("RolandTR909").gain(0.4).hpf(2800),

  // Sharp clap on transient
  s("cp").bank("RolandTR909").gain(0.55).hpf(1200)
)
